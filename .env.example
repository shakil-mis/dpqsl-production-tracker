# Copy this file to ".env" for LOCAL development only.
# On Render, you do NOT upload this file — you type these same values into
# Render's dashboard under Environment > Environment Variables instead.

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string

# --- Database (Neon) ---
# Get this from your Neon project dashboard > Connection string
# Leave blank/unset locally if you want to keep using your local Postgres.
DATABASE_URL=postgresql://user:password@your-neon-host/dbname?sslmode=require

# --- Cloudinary (operator photos) ---
# Get these 3 values from cloudinary.com dashboard after signup
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Render sets PORT automatically — you don't need to set it yourself.
